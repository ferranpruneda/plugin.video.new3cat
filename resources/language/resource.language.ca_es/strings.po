msgctxt "#30160"
msgid "Television channels that are on the air right now."
msgstr "Els canals de televisió que ara mateix són en antena."

msgctxt "#30161"
msgid "Rows of what people watch most: series, films, documentaries and more."
msgstr "Les files del que més s'ha mirat: sèries, pel·lícules, documentals i més."

msgctxt "#30162"
msgid "Videos just published on the website."
msgstr "Els vídeos que s'acaben de publicar al web."

msgctxt "#30163"
msgid "The website sections, from series to sport and culture."
msgstr "Les seccions del web, de les sèries als esports i a la cultura."

msgctxt "#30164"
msgid "Every programme, or only those under one letter."
msgstr "Tots els programes, o només els d'una lletra."

msgctxt "#30165"
msgid "Type a title and choose programmes or videos."
msgstr "Escriu un títol i tria si busques programes o vídeos."

msgctxt "#30166"
msgid "Say a title with the keyboard or remote microphone."
msgstr "Dicta un títol amb el micròfon del teclat o del comandament."

msgctxt "#30167"
msgid "What you have started on this device, so you can pick it up again."
msgstr "El que has començat a veure en aquest aparell, per reprendre-ho."

msgctxt "#30168"
msgid "The whole catalogue, not filtered by the first letter."
msgstr "El catàleg sencer, sense filtrar per la lletra inicial."

msgctxt "#30169"
msgid "Programmes whose title starts with a number or a symbol."
msgstr "Programes el títol dels quals comença per un número o un signe."

msgctxt "#30170"
msgid "Programmes whose title starts with %s."
msgstr "Programes el títol dels quals comença per %s."

msgctxt "#30171"
msgid "Programmes that match «%s»."
msgstr "Programes que coincideixen amb «%s»."

msgctxt "#30172"
msgid "Videos and episodes that match «%s»."
msgstr "Vídeos i capítols que coincideixen amb «%s»."

msgctxt "#30173"
msgid "Programmes and videos in the «%s» section."
msgstr "Programes i vídeos de la secció «%s»."

msgctxt "#30174"
msgid "Programmes gathered under «%s»."
msgstr "Programes aplegats a «%s»."

msgctxt "#30175"
msgid "Live channels in this section."
msgstr "Els canals en directe d'aquesta secció."

msgctxt "#30176"
msgid "The categories under this section."
msgstr "Les categories que pengen d'aquesta secció."

msgctxt "#30177"
msgid "Thematic channels that are broadcasting live."
msgstr "Canals temàtics que emeten en directe."

msgctxt "#30178"
msgid "Other programmes in the same theme as the ones you have watched."
msgstr "Altres programes de la mateixa temàtica que els que has mirat."

msgctxt "#30179"
msgid "This channel's live broadcast."
msgstr "Emissió en directe d'aquest canal."

msgctxt "#30180"
msgid "News, interviews and what is happening now."
msgstr "Informatius, entrevistes i el que està passant."

msgctxt "#30181"
msgid "Programmes for learning and for school."
msgstr "Continguts per aprendre i per a l'escola."

msgctxt "#30182"
msgid "Recipes, cooks and cooking shows."
msgstr "Receptes, cuiners i programes de cuina."

msgctxt "#30183"
msgid "Culture, explainers and programmes about the world."
msgstr "Cultura, divulgació i programes per entendre el món."

msgctxt "#30184"
msgid "Documentaries and reports to watch in full."
msgstr "Documentals i reportatges per mirar sencers."

msgctxt "#30185"
msgid "Entertainment, comedy and variety shows."
msgstr "Programes d'entreteniment, humor i varietats."

msgctxt "#30186"
msgid "Competitions, live sport and sports programmes."
msgstr "Competicions, retransmissions i programes d'esport."

msgctxt "#30187"
msgid "Concerts, sessions and music programmes."
msgstr "Concerts, sessions i programes de música."

msgctxt "#30188"
msgid "Films and TV movies in the catalogue."
msgstr "Pel·lícules i telefilms del catàleg."

msgctxt "#30189"
msgid "Fiction series, with their seasons and episodes."
msgstr "Sèries de ficció, amb les temporades i els capítols."

msgctxt "#30190"
msgid "Series and programmes from the SX3 children's channel."
msgstr "Sèries i programes del canal infantil SX3."

msgctxt "#30191"
msgid "Videos gathered under «%s»."
msgstr "Vídeos aplegats a «%s»."

msgctxt "#30192"
msgid "The chart «%s»."
msgstr "La classificació «%s»."

msgctxt "#30193"
msgid "The highlight «%s»."
msgstr "El destacat «%s»."

msgctxt "#30194"
msgid "Items gathered under «%s»."
msgstr "Continguts aplegats a «%s»."
